<?xml version="1.0" encoding="utf-8"?>
<!-- One look (left, right or blink) and what it does. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/colorDot"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:background="@drawable/bg_dot" />

            <TextView
                android:id="@+id/gestureTitle"
                style="@style/Text.Heading"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/actionName"
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/actionGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/optNone"
                style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="@string/opt_none"
                app:icon="@drawable/ic_none" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/optSwitch"
                style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="@string/opt_switch"
                app:icon="@drawable/ic_switch" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/optSong"
                style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="@string/opt_song"
                app:icon="@drawable/ic_music" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/optLights"
                style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="@string/opt_lights"
                app:icon="@drawable/ic_lights" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/optBoth"
                style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="@string/opt_both"
                app:icon="@drawable/ic_music_lights" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <LinearLayout
            android:id="@+id/songRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_music"
                android:tint="@color/muted" />

            <TextView
                android:id="@+id/songLabel"
                style="@style/Text.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="middle"
                android:singleLine="true" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chooseSongButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/button_choose_song" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/builtInButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/button_built_in" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
